!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Release signing -- never commit real passwords or the actual keystore
android/keystore.properties

# NOTE: android/app/google-services.json and
# ios/MissedMoments/GoogleService-Info.plist ARE committed on purpose. They are
# Firebase *client* config (they ship inside every built app and are
# extractable from any APK/IPA), not secrets, and the iOS build on another
# machine needs the plist present. The real secret is the server-side
# FIREBASE_SERVICE_ACCOUNT_JSON, which lives only in the server's .env.
